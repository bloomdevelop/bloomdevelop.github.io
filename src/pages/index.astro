---
import MainLayout from '@/layouts/main-layout.astro';
import Notes from '@/components/vue/notes.vue';
import { loadNotes, type LogEntry } from '@/scripts/atproto/notes';

// Pre-render the public notes so the page is readable and indexable without JS.
let initialEntries: LogEntry[] = [];
let initialError = '';

try {
    initialEntries = (await loadNotes()).entries;
} catch (e) {
    initialError = e instanceof Error ? e.message : String(e);
}
---

<MainLayout description="Notes from Spring, published through the AT Protocol.">
    <Notes client:load initialEntries={initialEntries} initialError={initialError} />
</MainLayout>
