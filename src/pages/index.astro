---
import BaseLayout from "../layouts/base-layout.astro";
import NavMenu from "../components/nav-menu.vue";
import Logs from "../components/logs.astro";
import Blogs from "../components/blogs.astro";
---

<BaseLayout>
    <NavMenu client:only />
    <main id="main-content" class="has-nav">
        <section>
            <h2>Links</h2>
            <div class="links">
                <a
                    class="link link--twitter"
                    href="https://twitter.com/spring_meowmeow"
                    target="_blank"
                    rel="noopener noreferrer"
                >
                    Twitter
                </a>
                <a
                    class="link link--bluesky"
                    href="https://bsky.app/profile/spring.furrest.net"
                    target="_blank"
                    rel="noopener noreferrer"
                >
                    Bluesky
                </a>
                <a
                    class="link link--github"
                    href="https://github.com/bloomdevelop"
                    target="_blank"
                    rel="noopener noreferrer"
                >
                    GitHub
                </a>
            </div>
        </section>
        <section>
            <h2>Servers</h2>
            <div class="mb-3">
                <p>
                    Since I moderate the server named "The Furrest". I would
                    like to invite you to talk with each others here :)
                </p>
                <p>They're chill here, no worries btw.</p>
            </div>
            <div class="my-3 alert alert--warning">
                <p>Please follow the rules first when joining please...</p>
            </div>
            <div class="links">
                <a class="link link--discord" href="https://discord.gg/r6B9YDyCe6">
                    Discord
                </a>
                <a class="link link--fluxer" href="https://fluxer.gg/zhQgXWsq">
                    Fluxer
                </a>
            </div>
        </section>
        <section>
            <h2>Blog</h2>
            <Blogs />
        </section>
        <section>
            <h2 class="flex items-center gap-2">
                Logs <span class="badge badge--primary">
                    Powered by ATProto
                </span>
            </h2>
            <Logs />
        </section>
    </main>
</BaseLayout>
