---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/base-layout.astro';
import Tag from '../../components/tag.astro';
import { fade } from "astro:transitions";

const blogZoom = {
	forwards: {
		old: { name: "vt-blog-zoom-out", duration: "420ms", easing: "cubic-bezier(0.22, 1, 0.36, 1)", fillMode: "both" },
		new: { name: "vt-blog-zoom-in", duration: "420ms", easing: "cubic-bezier(0.22, 1, 0.36, 1)", fillMode: "both" },
	},
	backwards: {
		old: { name: "vt-blog-zoom-out", duration: "360ms", easing: "cubic-bezier(0.22, 1, 0.36, 1)", fillMode: "both" },
		new: { name: "vt-blog-zoom-in", duration: "360ms", easing: "cubic-bezier(0.22, 1, 0.36, 1)", fillMode: "both" },
	},
};

export async function getStaticPaths() {
  const posts = await getCollection("blog");
  const visiblePosts = posts.filter((post) => import.meta.env.DEV || !post.data.draft);
  return visiblePosts.map(post => ({
    params: { id: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

---

<BaseLayout>
    <nav transition:animate={fade({ duration: "0.22s" })}>
        <a href="/" data-component="button" data-color>
          <span class="md-symbols">arrow_back</span>
          Back to home page
        </a>
    </nav>
    <article
        id="main-content"
        data-blog-rkey={post.id}
        transition:name={`blog-card-${post.id}`}
        transition:animate={blogZoom}
    >
        <div class="post-details">
            <h1 transition:name={`blog-title-${post.id}`} style="contain: layout;">{post.data.title}</h1>
            <p>Published on {post.data.pubDate.toLocaleDateString()}</p>
            {post.data.draft && import.meta.env.DEV && (
              <div data-component="alert">
                    <p>This post is a draft and may not be published yet. Please revise the content and publish when ready.</p>
              </div>
            )}

            <div data-component="tags">
                {post.data.tags?.map((tag) => <Tag tag={tag} />)}
            </div>
        </div>

        <div transition:animate={fade({ duration: "0.28s" })}>
            <Content />
        </div>
    </article>
</BaseLayout>

<style>
nav {
  position: sticky;
  z-index: 200 !important;
}

article {
  margin-inline: auto;
  max-width: 68ch;
}

.post-details {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
}
</style>
