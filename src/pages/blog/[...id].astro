---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/base-layout.astro';
import Tag from '../../components/tag.astro';

export async function getStaticPaths() {
  const posts = await getCollection("blog");
  return posts.map(post => ({
    params: { id: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

---

<BaseLayout>
    <nav>
        <a href="/" data-component="button" data-variant="primary">
          <span class="md-symbols">arrow_back</span>
          Back to home page
        </a>
    </nav>
    <article id="main-content">
        <div class="post-details">
            <h1>{post.data.title}</h1>
            <p>Published on {post.data.pubDate.toLocaleDateString()}</p>
            {post.data.draft && (
              <div data-component="alert">
                    <p>This post is a draft and may not be published yet. Please revise the content and publish when ready.</p>
              </div>
            )}

            <div style="display: flex; gap: 0.5rem; flex-wrap: wrap;">
                {post.data.tags?.map((tag) => <Tag tag={tag} />)}
            </div>
        </div>

        <Content />
    </article>
</BaseLayout>

<style>
nav {
  position: sticky;
  z-index: 200 !important;
}

article {
  margin-inline: auto;
  max-width: 80ch;
}

.post-details {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
}
</style>
