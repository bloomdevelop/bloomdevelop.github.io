---
import MainLayout from '@/layouts/main-layout.astro';
import EmptyState from '@/components/astro/empty-state.astro';
---

<MainLayout>
    <EmptyState
        class="flex-1"
        catPrefix="?"
        titleClass="font-bold"
        description="Looks like you're looking for something that doesn't exist"
    >
        <Fragment slot="title">
            <span class="text-error">404</span> Not Found
        </Fragment>
        <small class="text-ink-subtle">
            ...or maybe you're finding something that doesn't exist?
        </small>
    </EmptyState>
</MainLayout>
