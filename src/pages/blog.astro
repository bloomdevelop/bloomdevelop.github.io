---
import MainLayout from '@/layouts/main-layout.astro';
import { getCollection } from 'astro:content';
import DitheredImage from '@/components/astro/dithered-image.astro';
import EmptyState from '@/components/astro/empty-state.astro';

const publications = (
    await getCollection('blog', ({ data }) => import.meta.env.DEV || !data.draft)
).toSorted((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

// Helper function
function formatDate(date: string) {
    const formatter = new Intl.DateTimeFormat('en-US', {
        dateStyle: 'long',
    });

    return formatter.format(new Date(date));
}
---

<MainLayout
    title="Publications"
    description="Longer writings by Spring, from Linux reviews to notes on software."
>
    <h1 class="text-2xl mb-3">Publications</h1>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-2">
        {!publications.length && <EmptyState />}
        {publications.map((publication) => (
            <a
                href={`/blog/${publication.id}`}
                class="border-2 border-nijimi-1 hover:border-link hover:bg-nijimi-0"
            >
                {publication.data.headerImage && (
                    <div class="relative mb-2 aspect-video mask-[linear-gradient(to_bottom,black,transparent)]">
                        <DitheredImage
                            src={publication.data.headerImage}
                            width={640}
                            pixelSize={3}
                            class="h-full w-full"
                        />
                    </div>
                )}
                <div class="p-2">
                    <h3 class="flex gap-4 items-center">{publication.data.title}</h3>
                    <div class="flex gap-2">
                        <small>
                            <time datetime={publication.data.pubDate.toString()}>
                                {formatDate(publication.data.pubDate.toString())}
                            </time>
                        </small>
                        {publication.data.draft && (
                            <small class="bg-error text-paper px-1 rounded-sm font-bold">
                                Draft
                            </small>
                        )}
                    </div>
                </div>
            </a>
        ))}
    </div>
</MainLayout>
