---
import MainLayout from '@/layouts/main-layout.astro';
import { getCollection } from 'astro:content';
import DitheredImage from '@/components/astro/dithered-image.astro';

const publications = (
    await getCollection('blog', ({ data }) => import.meta.env.DEV || !data.draft)
).toSorted((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

// Helper function
function formatDate(date: string) {
    const formatter = new Intl.DateTimeFormat('en-US', {
        dateStyle: 'long',
    });

    return formatter.format(new Date(date));
}
---

<MainLayout>
    <h1 class="text-2xl mb-3">Publications</h1>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-2">
        {!publications.length && (
            <div class="flex flex-col justify-center items-center min-w-full min-h-full">
                <pre class="font-maple-mono whitespace-pre leading-none text-ink-subtle font-bold">
           /\___/\
         &gt;(-  _  -)&lt;
        \_( ______)
                </pre>
                <h2 class="text-3xl">Coming Soon</h2>
                <span>Come back later!</span>
            </div>
        )}
        {publications.map((publication) => (
            <a
                href={`/blog/${publication.id}`}
                class="border-2 border-nijimi-1 hover:border-link hover:bg-nijimi-0"
            >
                {publication.data.headerImage && (
                    <div class="relative mb-2 aspect-video mask-[linear-gradient(to_bottom,black,transparent)]">
                        <DitheredImage
                            src={publication.data.headerImage}
                            width={640}
                            pixelSize={3}
                            class="h-full w-full"
                        />
                    </div>
                )}
                <div class="p-2">
                    <h3 class="flex gap-4 items-center">
                        {publication.data.title}
                        {publication.data.draft && (
                            <small class="text-error font-bold">Draft</small>
                        )}
                    </h3>
                    <small>
                        <date>{formatDate(publication.data.pubDate.toString())}</date>
                    </small>
                </div>
            </a>
        ))}
    </div>
</MainLayout>
