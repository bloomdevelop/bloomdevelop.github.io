---
import { DEFAULT_PREVIEW_PDS } from '@/scripts/consts';
import { Font } from 'astro:assets';

interface Props {
    title?: string;
    description?: string;
    image?: string;
    type?: 'website' | 'article';
    noindex?: boolean;
    publishedTime?: string;
    modifiedTime?: string;
}

const {
    title,
    description = "Spring's personal website: notes, publications, and projects.",
    image,
    type = 'website',
    noindex = false,
    publishedTime,
    modifiedTime,
} = Astro.props;

const siteName = "Spring's Website";
const fullTitle = title ? `${title} — ${siteName}` : siteName;
const canonical = Astro.site
    ? new URL(Astro.url.pathname, Astro.site).toString()
    : Astro.url.pathname;
const imageUrl = image ? new URL(image, Astro.site ?? Astro.url).toString() : undefined;
---

<head>
    <meta charset="UTF-8" />
    {import.meta.env.DEV ? (
        <>
            <link rel="icon" type="image/svg+xml" href="/favicon-dev.svg" />
            <link rel="icon" href="/favicon-dev.ico" />
        </>
    ) : (
        <>
            <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
            <link rel="icon" href="/favicon.ico" />
        </>
    )}
    <title>{fullTitle}</title>

    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#f6eff8" />
    <script is:inline>
        (() => {
            const dark = (() => {
                try {
                    const stored = localStorage.getItem('madoromi');
                    if (stored === 'haru-hiru' || stored === 'haru-yoru')
                        return stored === 'haru-yoru';
                } catch {
                    // Storage can be unavailable; fall back to the system preference.
                }
                return window.matchMedia('(prefers-color-scheme: dark)').matches;
            })();

            document.documentElement.dataset.madoromi = dark ? 'haru-yoru' : 'haru-hiru';
            document
                .querySelector('meta[name="theme-color"]')
                ?.setAttribute('content', dark ? '#241c26' : '#f6eff8');
        })();
    </script>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}

    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonical} />
    {imageUrl && <meta property="og:image" content={imageUrl} />}
    {type === 'article' && publishedTime && (
        <meta property="article:published_time" content={publishedTime} />
    )}
    {type === 'article' && modifiedTime && (
        <meta property="article:modified_time" content={modifiedTime} />
    )}

    <meta name="twitter:card" content={imageUrl ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    {imageUrl && <meta name="twitter:image" content={imageUrl} />}

    <link rel="alternate" type="application/rss+xml" title={siteName} href="/rss.xml" />

    <link rel="preconnect" href={DEFAULT_PREVIEW_PDS} />
    <link rel="preconnect" href="https://api.bsky.app" />
    <link
        rel="preload"
        href="/fonts/Intern-Variable.woff2"
        as="font"
        type="font/woff2"
        crossorigin="anonymous"
    />
    <link
        rel="preload"
        href="/fonts/MaterialSymbolsRounded-subset.woff2"
        as="font"
        type="font/woff2"
        crossorigin="anonymous"
    />
    <Font cssVariable="--inter-variable" preload />
</head>
