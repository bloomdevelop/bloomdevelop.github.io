---
interface Props {
    as?: string;
    class?: string;
}

const { as: Tag = 'article', class: className } = Astro.props;
---

<Tag
    class:list={[
        'prose max-w-none text-ink',
        'prose-headings:font-intern prose-headings:text-prose-heading prose-a:text-prose-link',
        'prose-code:font-maple-mono prose-code:text-prose-code prose-code:before:content-none prose-code:after:content-none',
        'prose-blockquote:text-prose-quote prose-li:marker:text-prose-list',
        className,
    ]}
>
    <slot />
</Tag>
