---
import NavigationLink from './navigation-link.astro';
---

<nav class="py-4">
    <div class="mx-auto flex w-full max-w-4xl flex-wrap items-center justify-between gap-x-4 gap-y-2 px-3 sm:gap-x-6">
        <span class="text-2xl font-bold">Spring's Website</span>

        <div class="flex flex-row items-center gap-4 sm:gap-6">
            <NavigationLink href="/">Home</NavigationLink>
            <NavigationLink href="/blog">Blog</NavigationLink>
            <NavigationLink href="/projects">Projects</NavigationLink>
            <button
                id="theme-toggle"
                type="button"
                aria-label="Switch to dark theme"
                title="Switch to dark theme"
                class="flex size-9 items-center justify-center hover:bg-surface-1 focus-visible:bg-surface-1"
            >
                <span class="font-md-symbols dark:hidden" aria-hidden="true">
                    dark_mode
                </span>
                <span class="hidden font-md-symbols dark:inline" aria-hidden="true">
                    light_mode
                </span>
            </button>
        </div>
    </div>
</nav>

<script>
    import { initTheme } from '@/scripts/theme';

    initTheme();
</script>
