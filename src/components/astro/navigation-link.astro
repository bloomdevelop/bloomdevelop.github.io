---
interface Props {
    href: string;
}

const { href } = Astro.props;
const normalizePath = (path: string) => path.replace(/\/+$/, '') || '/';
const isCurrent = normalizePath(Astro.url.pathname) === normalizePath(href);
---

<a
    class:list={[
        'hover:text-link hover:font-semibold hover:underline',
        { 'text-accent font-semibold underline': isCurrent },
    ]}
    aria-current={isCurrent ? 'page' : undefined}
    href={href}
>
    <slot />
</a>
