---
function hashTag(tag: string): number {
    let hash = 0;
    for (let i = 0; i < tag.length; i++) {
        hash = (hash * 31 + tag.charCodeAt(i)) >>> 0;
    }
    return hash;
}

const { tag } = Astro.props as { tag: string };

const hash = hashTag(tag);
const hue = hash % 360;
const chroma = 0.15 + ((hash >>> 8) % 13) / 100;
const lightness = 0.42 + ((hash >>> 16) % 14) / 100;
const background = `oklch(${lightness} ${chroma} ${hue})`;
const color = lightness > 0.6 ? "var(--ink)" : "var(--paper)";
---

<span data-component="badge" style={`--color: ${background}; color: ${color}`}>{tag}</span>