---
import {
  DEFAULT_PREVIEW_DID,
  DEFAULT_PREVIEW_PDS,
  NEW_LOG_LEXICON,
} from "../scripts/consts";
import {
  constructApiUrl,
  extractRkeyFromPlainAtURI,
  formatDate,
} from "../scripts/utils";

interface LogEntry {
  rkey: string;
  content: string;
  createdAt: string;
  blueskyPost?: boolean;
}

async function fetchPostsFromPreviewDID(): Promise<LogEntry[]> {
  const res = await fetch(
    constructApiUrl(
      "com.atproto.repo.listRecords",
      {
        repo: DEFAULT_PREVIEW_DID,
        collection: NEW_LOG_LEXICON,
      },
      DEFAULT_PREVIEW_PDS,
    ),
  );

  if (!res.ok) {
    throw new Error(`Could not load logs: ${res.statusText}`);
  }

  const { records } = await res.json();

  return records.map((record: any) => ({
    ...record.value,
    rkey: extractRkeyFromPlainAtURI(record.uri),
  }));
}

let posts: LogEntry[] = [];
let fetchError: string | null = null;

try {
  posts = await fetchPostsFromPreviewDID();
} catch (e) {
  fetchError = e instanceof Error ? e.message : String(e);
  console.error("[APP]", "failed to fetch logs:", e);
}
---

<script type="application/json" id="logs-initial" is:inline>
{encodeURIComponent(JSON.stringify(posts))}
</script>

<div class="logs" id="logs">
  <p role="status" aria-atomic="true" class="visually-hidden" id="logs-status"></p>
  {fetchError ? (
    <div role="alert" data-component="alert" data-variant="error">
      {fetchError}
    </div>
  ) : posts.length === 0 ? (
    <div data-component="alert" data-variant="warning">
      There's no logs… yet. :(
    </div>
  ) : (
    posts.map((log) => (
      <div data-component="card" data-rkey={log.rkey}>
        <div class="card-content">
          <p>{log.content}</p>
        </div>
        <footer>
          <span data-type="date">{formatDate(log.createdAt)}</span>
          {log.blueskyPost && (
            <div data-component="badge" data-variant="secondary">
              <span class="md-symbols" aria-hidden="true">share</span>
              Crossposted
            </div>
          )}
          <button data-component="button" data-variant="primary" data-rkey={log.rkey}>
            <span class="md-symbols" aria-hidden="true">link</span>
            <span>Permalink</span>
          </button>
        </footer>
      </div>
    ))
  )}
</div>

<script>
import { getLogs, setLogs, subscribe, mergeWithPending } from "../scripts/logsStore";
import { formatDate } from "../scripts/utils";

const container = document.getElementById("logs");
if (!container) {
  throw new Error("Logs container not found");
}

const dataEl = document.getElementById("logs-initial");
if (dataEl) {
  try {
    const raw = dataEl.textContent?.trim();
    if (raw) {
      const initialLogs: any[] = JSON.parse(decodeURIComponent(raw));
      const merged = mergeWithPending(initialLogs);
      if (merged.length > 0) {
        setLogs(merged);
      }
    }
  } catch (e) {
    console.error("[APP]", "failed to parse initial logs:", e);
  }
}

function escapeHtml(text: string): string {
  const div = document.createElement("div");
  div.appendChild(document.createTextNode(text));
  return div.innerHTML;
}

function makeCardHTML(log: any): string {
  const shareIcon = '<span class="md-symbols" aria-hidden="true">share</span>';
  const linkIcon = '<span class="md-symbols" aria-hidden="true">link</span>';

  return `
    <div data-component="card" data-rkey="${log.rkey}">
      <div class="card-content">
        <p>${escapeHtml(log.content)}</p>
      </div>
      <footer>
        <span data-type="date">${formatDate(log.createdAt)}</span>
        ${
          log.blueskyPost
            ? `<div data-component="badge" data-variant="secondary">${shareIcon}Crossposted</div>`
            : ""
        }
        <button data-component="button" data-variant="primary" data-rkey="${log.rkey}">
          ${linkIcon}<span>Permalink</span>
        </button>
      </footer>
    </div>
  `;
}

async function copyToClipboard(text: string): Promise<boolean> {
  if (navigator.clipboard?.writeText) {
    try {
      await navigator.clipboard.writeText(text);
      return true;
    } catch {
      // fall through to fallback
    }
  }
  try {
    const textarea = document.createElement("textarea");
    textarea.value = text;
    textarea.style.position = "fixed";
    textarea.style.opacity = "0";
    textarea.style.pointerEvents = "none";
    document.body.appendChild(textarea);
    textarea.select();
    document.execCommand("copy");
    document.body.removeChild(textarea);
    return true;
  } catch {
    return false;
  }
}

container.addEventListener("click", async (e) => {
  const button = (e.target as HTMLElement).closest('[data-component="button"][data-rkey]');
  if (!button) return;
  const rkey = button.getAttribute("data-rkey");
  if (!rkey) return;

  const permalink = new URL(window.location.href);
  permalink.searchParams.set("rkey", rkey);

  const span = button.querySelector("span:last-child");
  const original = span?.textContent;

  if (await copyToClipboard(permalink.toString())) {
    if (span) {
      span.textContent = "Copied!";
      setTimeout(() => { span.textContent = original; }, 2000);
    }
  } else {
    console.error("[APP]", "failed to copy permalink");
    if (span) span.textContent = "Unable to copy permalink";
  }
});

const rkeyParam = new URL(window.location.href).searchParams.get("rkey");
if (rkeyParam) {
  const scrollToCard = () => {
    const target = container.querySelector(`[data-rkey="${CSS.escape(rkeyParam)}"]`);
    if (!target) return;
    const card = target.closest("[data-component=card]");
    if (!card) return;
    card.scrollIntoView({ behavior: "instant", block: "start" });
  };
  const queueScroll = () => {
    requestAnimationFrame(() => requestAnimationFrame(scrollToCard));
  };
  if (document.readyState === "complete") {
    queueScroll();
  } else {
    window.addEventListener("load", queueScroll, { once: true });
  }
}

subscribe(() => {
  const allLogs = getLogs();
  if (allLogs.length === 0) return;

  const statusEl = container.querySelector("#logs-status");
  const anchor = statusEl?.nextSibling ?? container.firstChild;

  for (const log of allLogs) {
    if (container.querySelector(`[data-rkey="${CSS.escape(log.rkey)}"]`)) continue;

    const wrapper = document.createElement("div");
    wrapper.innerHTML = makeCardHTML(log);
    const card = wrapper.firstElementChild;
    if (!card) continue;

    if (anchor) {
      container.insertBefore(card, anchor);
    } else {
      container.appendChild(card);
    }
  }
});
</script>
