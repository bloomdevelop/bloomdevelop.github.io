---
import type { LogEntry } from "../scripts/logsStore";
import { fetchLogsFromPreviewDID } from "../scripts/logsApi";
import { formatDate } from "../scripts/utils";

let posts: LogEntry[] = [];
let fetchError: string | null = null;

try {
  posts = await fetchLogsFromPreviewDID();
} catch (e) {
  fetchError = e instanceof Error ? e.message : String(e);
  console.error("[APP]", "failed to fetch logs:", e);
}
---

<script type="application/json" id="logs-initial" is:inline>
{encodeURIComponent(JSON.stringify(posts))}
</script>

<div class="logs" id="logs">
  <p role="status" aria-atomic="true" class="visually-hidden" id="logs-status"></p>
  {fetchError ? (
    <div role="alert" data-component="alert" data-color="error" data-logs-error>
      {fetchError}
    </div>
  ) : posts.length === 0 ? (
    <div data-component="alert" data-color="warning" data-logs-empty>
      There's no logs… yet. :(
    </div>
  ) : (
    posts.map((log) => (
      <div data-component="card" data-rkey={log.rkey}>
        <div class="card-content"><p>{log.content}</p></div>
        <footer>
          <span data-type="date">{formatDate(log.createdAt)}</span>
          {log.blueskyPost && (
            <div data-component="badge" data-color="secondary">
              <span class="md-symbols" aria-hidden="true">share</span>
              Crossposted
            </div>
          )}
          <button data-component="button" data-color data-rkey={log.rkey}>
            <span class="md-symbols" aria-hidden="true">link</span>
            <span>Permalink</span>
          </button>
          <button
            data-component="button"
            data-color
            data-copy-twitter
            data-rkey={log.rkey}
            style="--color: var(--twitter); --color-contrast: white;"
          >
            <span class="md-symbols" aria-hidden="true">content_copy</span>
            <span>Copy as Twitter post</span>
          </button>
        </footer>
      </div>
    ))
  )}
</div>

<script>
import { fetchLogsFromPreviewDID } from "../scripts/logsApi";
import {
  STORAGE_KEY,
  getLogs,
  mergeLocalPending,
  mergeWithPending,
  setLogs,
  subscribe,
  type LogEntry,
} from "../scripts/logsStore";
import { formatDate } from "../scripts/utils";

const container = document.getElementById("logs");
if (!container) {
  throw new Error("Logs container not found");
}

const SYNC_INTERVAL_MS = 60_000;
let lastSyncFailed = false;
let syncing = false;

// Seed the store from the server-rendered snapshot so the page renders
// instantly, then re-sync against the PDS so the cached page state catches up
// with the latest records.
const dataEl = document.getElementById("logs-initial");
if (dataEl) {
  try {
    const raw = dataEl.textContent?.trim();
    if (raw) {
      const initialLogs: LogEntry[] = JSON.parse(decodeURIComponent(raw));
      const merged = mergeWithPending(initialLogs);
      if (merged.length > 0) {
        setLogs(merged);
      }
    }
  } catch (e) {
    console.error("[APP]", "failed to parse initial logs:", e);
  }
}

/**
 * Fetch the latest logs from the PDS, merge in anything still pending
 * locally, and hand the result to the store (which re-renders the list).
 */
async function syncLogs() {
  if (syncing) return;
  syncing = true;
  try {
    const fresh = await fetchLogsFromPreviewDID();
    lastSyncFailed = false;
    setLogs(mergeWithPending(fresh));
  } catch (e) {
    console.error("[APP]", "failed to sync logs:", e);
    lastSyncFailed = true;
    renderLogs();
  } finally {
    syncing = false;
  }
}

function escapeHtml(text: string): string {
  const div = document.createElement("div");
  div.appendChild(document.createTextNode(text));
  return div.innerHTML;
}

function makeCardHTML(log: LogEntry): string {
  const shareIcon = '<span class="md-symbols" aria-hidden="true">share</span>';
  const linkIcon = '<span class="md-symbols" aria-hidden="true">link</span>';
  const twitterCopyIcon =
    '<span class="md-symbols" aria-hidden="true">content_copy</span>';
  const twitterStyle = 'style="--color: var(--twitter); --color-contrast: white;"';

  return `
    <div data-component="card" data-rkey="${log.rkey}">
      <div class="card-content"><p>${escapeHtml(log.content)}</p></div>
      <footer>
        <span data-type="date">${formatDate(log.createdAt)}</span>
        ${
          log.blueskyPost
            ? `<div data-component="badge" data-color="secondary">${shareIcon}Crossposted</div>`
            : ""
        }
        <button data-component="button" data-color data-rkey="${log.rkey}">
          ${linkIcon}<span>Permalink</span>
        </button>
        <button
          data-component="button"
          data-color
          data-copy-twitter
          data-rkey="${log.rkey}"
          ${twitterStyle}
        >
          ${twitterCopyIcon}<span>Copy as Twitter post</span>
        </button>
      </footer>
    </div>
  `;
}

async function copyToClipboard(text: string): Promise<boolean> {
  if (navigator.clipboard?.writeText) {
    try {
      await navigator.clipboard.writeText(text);
      return true;
    } catch {
      // fall through to fallback
    }
  }
  try {
    const textarea = document.createElement("textarea");
    textarea.value = text;
    textarea.style.position = "fixed";
    textarea.style.opacity = "0";
    textarea.style.pointerEvents = "none";
    document.body.appendChild(textarea);
    textarea.select();
    document.execCommand("copy");
    document.body.removeChild(textarea);
    return true;
  } catch {
    return false;
  }
}

container.addEventListener("click", async (e) => {
  const button = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-component="button"][data-rkey]');
  if (!button) return;
  const rkey = button.getAttribute("data-rkey");
  if (!rkey) return;

  const status = document.getElementById("logs-status");
  const span = button.querySelector("span:last-child");
  const original = span?.textContent ?? null;

  const permalink = new URL(window.location.href);
  permalink.searchParams.set("rkey", rkey);

  const isTwitterCopy = button.dataset.copyTwitter !== undefined;
  let text: string;
  let failureLabel: string;
  if (isTwitterCopy) {
    const content =
      button.closest("[data-component=card]")
        ?.querySelector(".card-content p")?.textContent?.trim() ?? "";
    text = [content, permalink.toString()].filter(Boolean).join("\n\n");
    failureLabel = "Unable to copy Twitter post";
  } else {
    text = permalink.toString();
    failureLabel = "Unable to copy permalink";
  }

  if (await copyToClipboard(text)) {
    if (span) {
      span.textContent = "Copied!";
      setTimeout(() => { span.textContent = original; }, 2000);
    }
    if (status) status.textContent = "Copied to clipboard.";
  } else {
    console.error("[APP]", isTwitterCopy ? "failed to copy twitter post" : "failed to copy permalink");
    if (span) span.textContent = failureLabel;
    if (status) status.textContent = `Failed to copy. ${failureLabel}`;
  }
});

const rkeyParam = new URL(window.location.href).searchParams.get("rkey");
if (rkeyParam) {
  const scrollToCard = () => {
    const target = container.querySelector(`[data-rkey="${CSS.escape(rkeyParam)}"]`);
    if (!target) return;
    const card = target.closest("[data-component=card]");
    if (!card) return;
    card.scrollIntoView({ behavior: "instant", block: "start" });
  };
  const queueScroll = () => {
    requestAnimationFrame(() => requestAnimationFrame(scrollToCard));
  };
  if (document.readyState === "complete") {
    queueScroll();
  } else {
    window.addEventListener("load", queueScroll, { once: true });
  }
}

/**
 * Reconcile the DOM with the store: drop cards that no longer exist, insert
 * missing cards at their sorted (newest-first) position, and keep the
 * empty/error state alerts in sync.
 */
const renderLogs = () => {
  const allLogs = getLogs();
  const byRkey = new Map(allLogs.map((log) => [log.rkey, log]));

  // Remove cards that are no longer part of the list.
  for (const el of Array.from(container.querySelectorAll<HTMLElement>("div[data-rkey]"))) {
    if (!byRkey.has(el.dataset.rkey ?? "")) el.remove();
  }

  // State alerts are rebuilt below from the current state.
  for (const el of Array.from(container.querySelectorAll<HTMLElement>("[data-logs-empty], [data-logs-error]"))) {
    el.remove();
  }

  if (allLogs.length === 0) {
    const wrapper = document.createElement("div");
    wrapper.innerHTML = lastSyncFailed
      ? '<div role="alert" data-component="alert" data-color="error" data-logs-error>Could not load logs.</div>'
      : '<div data-component="alert" data-color="warning" data-logs-empty>There\'s no logs… yet. :(</div>';
    container.appendChild(wrapper.firstElementChild as HTMLElement);
    return;
  }

  // Insert missing cards in their sorted (newest-first) position.
  for (const log of allLogs) {
    if (container.querySelector(`div[data-rkey="${CSS.escape(log.rkey)}"]`)) continue;

    const wrapper = document.createElement("div");
    wrapper.innerHTML = makeCardHTML(log);
    const card = wrapper.firstElementChild as HTMLElement | null;
    if (!card) continue;

    const createdAt = new Date(log.createdAt).getTime();
    let inserted = false;
    for (const el of container.querySelectorAll<HTMLElement>("div[data-rkey]")) {
      const existing = byRkey.get(el.dataset.rkey ?? "");
      if (existing && createdAt > new Date(existing.createdAt).getTime()) {
        container.insertBefore(card, el);
        inserted = true;
        break;
      }
    }
    if (!inserted) container.appendChild(card);
  }
}

subscribe(renderLogs);

// Paint anything from the seed that isn't in the cached HTML yet (e.g. logs
// pending locally), then sync with the PDS and keep polling while open.
renderLogs();
syncLogs();
setInterval(syncLogs, SYNC_INTERVAL_MS);

// Re-sync when the tab becomes visible again.
document.addEventListener("visibilitychange", () => {
  if (!document.hidden) syncLogs();
});

// Pick up logs composed in another tab (they land in localStorage).
window.addEventListener("storage", (e) => {
  if (e.key === STORAGE_KEY) mergeLocalPending();
});
</script>
