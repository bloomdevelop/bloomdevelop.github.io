---
import type { LogEntry } from "../scripts/logsStore";
import { fetchLogsFromPreviewDID } from "../scripts/logsApi";
import { formatDate } from "../scripts/utils";

let posts: LogEntry[] = [];
let fetchError: string | null = null;

try {
    posts = await fetchLogsFromPreviewDID();
} catch (error) {
    fetchError = error instanceof Error ? error.message : String(error);
    console.error("[APP]", "failed to fetch logs:", error);
}

function blueskyPostUrl(log: LogEntry): string | null {
    if (!log.blueskyPost || typeof log.blueskyPost !== "object") return null;
    const [repo, collection, rkey] = log.blueskyPost.uri.split("/").slice(2);
    if (!repo || collection !== "app.bsky.feed.post" || !rkey) return null;
    return `https://bsky.app/profile/${encodeURIComponent(repo).replaceAll("%3A", ":")}/post/${encodeURIComponent(rkey)}`;
}
---

<script
    type="application/json"
    id="logs-initial"
    is:inline
    set:html={encodeURIComponent(JSON.stringify(posts))}
></script>

<noscript>
    <div class="alert alert--error">
        Please enable Javascript, otherwise some features will not work!
    </div>
</noscript>

<div class="logs" id="logs">
    <p
        role="status"
        aria-atomic="true"
        class="visually-hidden"
        id="logs-status"
    ></p>
    {fetchError ? (
        <div role="alert" class="alert alert--error logs-error">
            {fetchError}
        </div>
    ) : posts.length === 0 ? (
        <div class="logs-skeleton" aria-hidden="true">
            <div class="card rounded-lg border p-lg">
                <div class="card-content">
                    <span class="skeleton-line" style="width: 92%"></span>
                    <span class="skeleton-line" style="width: 78%"></span>
                    <span class="skeleton-line" style="width: 60%"></span>
                </div>
                <footer>
                    <span class="skeleton-pill"></span>
                    <span class="skeleton-pill"></span>
                </footer>
            </div>
            <div class="card rounded-lg border p-lg">
                <div class="card-content">
                    <span class="skeleton-line" style="width: 85%"></span>
                    <span class="skeleton-line" style="width: 68%"></span>
                </div>
                <footer>
                    <span class="skeleton-pill"></span>
                    <span class="skeleton-pill"></span>
                    <span class="skeleton-pill"></span>
                </footer>
            </div>
        </div>
    ) : (
        posts.map((log) => (
            <div
                class="group relative card log-card rounded-lg border p-lg"
                data-log-card
                data-rkey={log.rkey}
            >
                {blueskyPostUrl(log) && (
                    <a
                        class="invisible group-hover:visible transition duration-200 transition-discrete group absolute top-1 right-1 max-w-8 max-h-8 w-full h-full rounded-concentric shadow-md flex justify-center items-center no-underline"
                        style="background: color-mix(in oklch, var(--surface), light-dark(black, white) 5%); border: 1px solid color-mix(in oklch, var(--surface), light-dark(black, white) 10%)"
                        href={blueskyPostUrl(log)!}
                        target="_blank"
                        rel="noopener noreferrer"
                        aria-label="View on Bluesky"
                    >
                        <span
                            class="group-hover:text-(--madoromi-aru) md-symbols text-md text-surface-contrast"
                            aria-hidden="true"
                        >
                            arrow_outward
                        </span>
                    </a>
                )}
                <div class="card-content">
                    <p>{log.content}</p>
                </div>
                <footer class="gap-2">
                    <span class="date">{formatDate(log.createdAt)}</span>
                    <button
                        class="ui-button ui-button--icon ui-button--colored rounded-concentric"
                        data-rkey={log.rkey}
                        aria-label="Copy permalink"
                    >
                        <span class="md-symbols" aria-hidden="true">
                            link
                        </span>
                    </button>
                    <button
                        class="ui-button ui-button--icon ui-button--colored rounded-concentric"
                        data-copy-twitter
                        data-rkey={log.rkey}
                        aria-label="Copy as Twitter post"
                        style="--color: var(--twitter); --color-contrast: white;"
                    >
                        <span class="md-symbols" aria-hidden="true">
                            content_copy
                        </span>
                    </button>
                </footer>
            </div>
        ))
    )}
</div>

<script>
    import { fetchLogsFromPreviewDID } from "../scripts/logsApi";
    import {
        STORAGE_KEY,
        getLogs,
        mergeLocalPending,
        mergeWithPending,
        setLogs,
        subscribe,
        type LogEntry,
    } from "../scripts/logsStore";
    import { formatDate } from "../scripts/utils";

    const foundContainer = document.getElementById("logs");
    const foundStatus = document.getElementById("logs-status");
    if (!foundContainer || !foundStatus)
        throw new Error("Logs container is incomplete");
    const container: HTMLElement = foundContainer;
    const status: HTMLElement = foundStatus;

    const SYNC_INTERVAL_MS = 60_000;
    let firstSyncDone = false;
    let lastSyncFailed = false;
    let syncing = false;
    let pollTimer = 0;
    let stateNode: HTMLElement | null = container.querySelector(
        ".logs-skeleton, .logs-error, .logs-empty",
    );
    const revertTimers = new WeakMap<HTMLButtonElement, number>();
    const cards = new Map<string, HTMLElement>();

    function blueskyUrl(log: LogEntry): string | null {
        if (!log.blueskyPost || typeof log.blueskyPost !== "object")
            return null;
        const [repo, collection, rkey] = log.blueskyPost.uri
            .split("/")
            .slice(2);
        if (!repo || collection !== "app.bsky.feed.post" || !rkey) return null;
        return `https://bsky.app/profile/${encodeURIComponent(repo).replaceAll("%3A", ":")}/post/${encodeURIComponent(rkey)}`;
    }

    function makeCard(log: LogEntry): HTMLElement {
        const card = document.createElement("div");
        card.className = "card log-card rounded-lg border p-lg";
        card.dataset.logCard = "";
        card.dataset.rkey = log.rkey;

        const content = document.createElement("div");
        content.className = "card-content";
        const paragraph = document.createElement("p");
        paragraph.textContent = log.content;
        content.append(paragraph);
        card.append(content);

        const footer = document.createElement("footer");
        const date = document.createElement("span");
        date.className = "date";
        date.textContent = formatDate(log.createdAt);
        footer.append(date);

        const postUrl = blueskyUrl(log);
        if (postUrl) {
            const link = document.createElement("a");
            link.href = postUrl;
            link.target = "_blank";
            link.rel = "noopener noreferrer";
            link.setAttribute("aria-label", "View on Bluesky");
            link.append(icon("arrow_outward"));
            footer.append(link);
        }
        footer.append(actionButton(log.rkey, "link", "Permalink"));
        const copyButton = actionButton(
            log.rkey,
            "content_copy",
            "Copy as Twitter post",
        );
        copyButton.dataset.copyTwitter = "";
        copyButton.style.setProperty("--color", "var(--twitter)");
        copyButton.style.setProperty("--color-contrast", "white");
        footer.append(copyButton);
        card.append(footer);
        return card;
    }

    function icon(name: string): HTMLSpanElement {
        const element = document.createElement("span");
        element.className = "md-symbols";
        element.setAttribute("aria-hidden", "true");
        element.textContent = name;
        return element;
    }

    function actionButton(
        rkey: string,
        iconName: string,
        labelText: string,
    ): HTMLButtonElement {
        const button = document.createElement("button");
        button.className = "ui-button ui-button--colored rounded-concentric";
        button.dataset.rkey = rkey;
        button.append(icon(iconName));
        button.setAttribute("aria-label", labelText);
        return button;
    }

    function makeSkeleton(): HTMLElement {
        const skeleton = document.createElement("div");
        skeleton.className = "logs-skeleton";
        skeleton.setAttribute("aria-hidden", "true");
        for (const widths of [
            [92, 78, 60],
            [85, 68],
        ]) {
            const card = document.createElement("div");
            card.className = "card rounded-lg border p-lg";
            const content = document.createElement("div");
            content.className = "card-content";
            for (const width of widths) {
                const line = document.createElement("span");
                line.className = "skeleton-line";
                line.style.width = `${width}%`;
                content.append(line);
            }
            card.append(content);
            const footer = document.createElement("footer");
            for (let i = 0; i < (widths.length === 3 ? 2 : 3); i++) {
                const pill = document.createElement("span");
                pill.className = "skeleton-pill";
                footer.append(pill);
            }
            card.append(footer);
            skeleton.append(card);
        }
        return skeleton;
    }

    function renderState(logCount: number) {
        status.textContent = "";
        stateNode?.remove();
        stateNode = null;
        if (logCount > 0) return;

        if (!firstSyncDone) {
            status.textContent = "Loading logs…";
            stateNode = makeSkeleton();
        } else {
            const message = document.createElement("div");
            message.className = lastSyncFailed
                ? "alert alert--error logs-error"
                : "alert alert--warning logs-empty";
            if (lastSyncFailed) message.setAttribute("role", "alert");
            message.textContent = lastSyncFailed
                ? "Could not load logs."
                : "There's no logs… yet. :(";
            stateNode = message;
        }
        container.insertBefore(stateNode, status.nextSibling);
    }

    function renderLogs() {
        const entries = getLogs();
        const active = new Set(entries.map((log) => log.rkey));
        for (const [rkey, card] of cards) {
            if (!active.has(rkey)) {
                card.remove();
                cards.delete(rkey);
            }
        }
        for (const card of container.querySelectorAll<HTMLElement>(
            "[data-log-card][data-rkey]",
        )) {
            if (!cards.has(card.dataset.rkey ?? "")) card.remove();
        }
        let anchor: ChildNode | null =
            stateNode?.nextSibling ?? status.nextSibling;
        for (const log of entries) {
            let card = cards.get(log.rkey);
            if (!card) {
                card = makeCard(log);
                cards.set(log.rkey, card);
            }
            if (card !== anchor) container.insertBefore(card, anchor);
            anchor = card.nextSibling;
        }
        renderState(entries.length);
    }

    for (const card of container.querySelectorAll<HTMLElement>(
        "[data-log-card][data-rkey]",
    )) {
        const key = card.dataset.rkey;
        if (key) cards.set(key, card);
    }

    const dataEl = document.getElementById("logs-initial");
    if (dataEl?.textContent) {
        try {
            const initialLogs = JSON.parse(
                decodeURIComponent(dataEl.textContent),
            ) as LogEntry[];
            setLogs(mergeWithPending(initialLogs));
        } catch (error) {
            console.error("[APP]", "failed to parse initial logs:", error);
        }
    }

    async function syncLogs() {
        if (syncing || document.hidden) return;
        syncing = true;
        try {
            setLogs(mergeWithPending(await fetchLogsFromPreviewDID()));
            lastSyncFailed = false;
        } catch (error) {
            console.error("[APP]", "failed to sync logs:", error);
            lastSyncFailed = true;
        } finally {
            firstSyncDone = true;
            syncing = false;
            renderLogs();
            if (!document.hidden)
                pollTimer = window.setTimeout(syncLogs, SYNC_INTERVAL_MS);
        }
    }

    async function copyToClipboard(text: string): Promise<boolean> {
        try {
            if (navigator.clipboard?.writeText) {
                await navigator.clipboard.writeText(text);
                return true;
            }
        } catch {
            // Use the legacy copy command when clipboard permissions are unavailable.
        }
        const field = document.createElement("textarea");
        field.value = text;
        field.style.cssText = "position:fixed;opacity:0;pointer-events:none";
        document.body.append(field);
        try {
            field.select();
            return document.execCommand("copy");
        } catch {
            return false;
        } finally {
            field.remove();
        }
    }

    container.addEventListener("click", async (event) => {
        const target = event.target;
        if (!(target instanceof Element)) return;
        const button = target.closest<HTMLButtonElement>("button[data-rkey]");
        if (!button) return;
        const rkey = button.dataset.rkey;
        if (!rkey) return;
        const permalink = new URL(window.location.href);
        permalink.searchParams.set("rkey", rkey);
        const originalLabel = button.getAttribute("aria-label") ?? "Copy";
        const isTwitterCopy = "copyTwitter" in button.dataset;
        const content =
            button
                .closest(".card")
                ?.querySelector(".card-content p")
                ?.textContent?.trim() ?? "";
        const copied = await copyToClipboard(
            isTwitterCopy
                ? [content, permalink.toString()].filter(Boolean).join("\n\n")
                : permalink.toString(),
        );
        window.clearTimeout(revertTimers.get(button));
        if (copied) {
            button.setAttribute("aria-label", "Copied!");
            revertTimers.set(
                button,
                window.setTimeout(
                    () => button.setAttribute("aria-label", originalLabel),
                    2000,
                ),
            );
        } else {
            button.setAttribute(
                "aria-label",
                isTwitterCopy
                    ? "Unable to copy Twitter post"
                    : "Unable to copy permalink",
            );
        }
        status.textContent = copied
            ? "Copied to clipboard."
            : "Failed to copy.";
    });

    subscribe(renderLogs);
    renderLogs();
    void syncLogs();
    document.addEventListener("visibilitychange", () => {
        window.clearTimeout(pollTimer);
        if (!document.hidden) void syncLogs();
    });
    window.addEventListener("storage", (event) => {
        if (event.key === STORAGE_KEY) mergeLocalPending();
    });

    const rkey = new URL(window.location.href).searchParams.get("rkey");
    if (rkey) {
        const target = cards.get(rkey);
        if (target)
            requestAnimationFrame(() =>
                target.scrollIntoView({ behavior: "instant", block: "start" }),
            );
    }
</script>
