---
import { getCollection } from "astro:content";
import Tag from "./tag.astro";

const blogPosts = (await getCollection("blog")).sort((a, b) => {
    return new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime();
});
---

<div class="blogs">

{blogPosts.length === 0 && <p>No posts yet. :(</p>}
{blogPosts.map((post) => (
    <a data-component="card" href={`/blog/${post.id}`}>
        <div class="card-header">
            <h2>{post.data.title}</h2>
            <p>{post.data.pubDate.toLocaleDateString()}</p>
        </div>
        <div class="card-content">
            <p>{post.data.description}</p>
        </div>
        <footer>
            <div data-component="tags">
                {post.data.tags?.map((tag) => <Tag tag={tag} />)}
            </div>
        </footer>
    </a>
))}

</div>