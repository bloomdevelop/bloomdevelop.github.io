---
interface Props {
    position?: "top" | "bottom";
    height?: string;
}

const { position = "bottom", height = "50px" } = Astro.props;

const BLUR_LEVELS_PX = [1, 2, 4, 8, 16, 32, 64];
---

<div
    class={`progressive-blur ${position}`}
    style={`--progressive-blur-height: ${height}`}
    aria-hidden="true"
>
    {BLUR_LEVELS_PX.map((px) => <div class="layer" style={`--blur: ${px}px`}></div>)}
    <div class="gradient"></div>
</div>

<style>
    .progressive-blur {
        position: fixed;
        z-index: 100;
        top: 0;
        left: 0;
        right: 0;
        width: 100%;
        height: var(--progressive-blur-height);
        pointer-events: none;
    }

    .progressive-blur.top {
        top: 0;
    }

    .progressive-blur.bottom {
        top: auto;
        bottom: 0;
    }

    .progressive-blur > .layer,
    .progressive-blur > .gradient {
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
    }

    .progressive-blur > .layer {
        backdrop-filter: blur(var(--blur));
    }

    .progressive-blur > .layer:nth-child(7) {
        z-index: 10;
    }

    /* Keep the surface gradient above every blur layer so it blends on top. */
    .progressive-blur > .gradient {
        z-index: 20;
    }

    .progressive-blur.bottom > .layer:nth-child(1) {
        mask-image: linear-gradient(rgba(0, 0, 0, 0), rgba(0, 0, 0, 1) 10%, rgba(0, 0, 0, 1) 30%, rgba(0, 0, 0, 0) 40%);
        -webkit-mask-image: linear-gradient(rgba(0, 0, 0, 0), rgba(0, 0, 0, 1) 10%, rgba(0, 0, 0, 1) 30%, rgba(0, 0, 0, 0) 40%);
    }

    .progressive-blur.bottom > .layer:nth-child(2) {
        mask-image: linear-gradient(rgba(0, 0, 0, 0) 10%, rgba(0, 0, 0, 1) 20%, rgba(0, 0, 0, 1) 40%, rgba(0, 0, 0, 0) 50%);
        -webkit-mask-image: linear-gradient(rgba(0, 0, 0, 0) 10%, rgba(0, 0, 0, 1) 20%, rgba(0, 0, 0, 1) 40%, rgba(0, 0, 0, 0) 50%);
    }

    .progressive-blur.bottom > .layer:nth-child(3) {
        mask-image: linear-gradient(rgba(0, 0, 0, 0) 15%, rgba(0, 0, 0, 1) 30%, rgba(0, 0, 0, 1) 50%, rgba(0, 0, 0, 0) 60%);
        -webkit-mask-image: linear-gradient(rgba(0, 0, 0, 0) 15%, rgba(0, 0, 0, 1) 30%, rgba(0, 0, 0, 1) 50%, rgba(0, 0, 0, 0) 60%);
    }

    .progressive-blur.bottom > .layer:nth-child(4) {
        mask-image: linear-gradient(rgba(0, 0, 0, 0) 20%, rgba(0, 0, 0, 1) 40%, rgba(0, 0, 0, 1) 60%, rgba(0, 0, 0, 0) 70%);
        -webkit-mask-image: linear-gradient(rgba(0, 0, 0, 0) 20%, rgba(0, 0, 0, 1) 40%, rgba(0, 0, 0, 1) 60%, rgba(0, 0, 0, 0) 70%);
    }

    .progressive-blur.bottom > .layer:nth-child(5) {
        mask-image: linear-gradient(rgba(0, 0, 0, 0) 40%, rgba(0, 0, 0, 1) 60%, rgba(0, 0, 0, 1) 80%, rgba(0, 0, 0, 0) 90%);
        -webkit-mask-image: linear-gradient(rgba(0, 0, 0, 0) 40%, rgba(0, 0, 0, 1) 60%, rgba(0, 0, 0, 1) 80%, rgba(0, 0, 0, 0) 90%);
    }

    .progressive-blur.bottom > .layer:nth-child(6) {
        mask-image: linear-gradient(rgba(0, 0, 0, 0) 60%, rgba(0, 0, 0, 1) 80%);
        -webkit-mask-image: linear-gradient(rgba(0, 0, 0, 0) 60%, rgba(0, 0, 0, 1) 80%);
    }

    .progressive-blur.bottom > .layer:nth-child(7) {
        mask-image: linear-gradient(rgba(0, 0, 0, 0) 70%, rgba(0, 0, 0, 1) 100%);
        -webkit-mask-image: linear-gradient(rgba(0, 0, 0, 0) 70%, rgba(0, 0, 0, 1) 100%);
    }

    .progressive-blur.bottom > .gradient {
        background: linear-gradient(transparent, var(--surface));
    }

    .progressive-blur.top > .layer:nth-child(1) {
        mask-image: linear-gradient(to top, rgba(0, 0, 0, 0), rgba(0, 0, 0, 1) 10%, rgba(0, 0, 0, 1) 30%, rgba(0, 0, 0, 0) 40%);
        -webkit-mask-image: linear-gradient(to top, rgba(0, 0, 0, 0), rgba(0, 0, 0, 1) 10%, rgba(0, 0, 0, 1) 30%, rgba(0, 0, 0, 0) 40%);
    }

    .progressive-blur.top > .layer:nth-child(2) {
        mask-image: linear-gradient(to top, rgba(0, 0, 0, 0) 10%, rgba(0, 0, 0, 1) 20%, rgba(0, 0, 0, 1) 40%, rgba(0, 0, 0, 0) 50%);
        -webkit-mask-image: linear-gradient(to top, rgba(0, 0, 0, 0) 10%, rgba(0, 0, 0, 1) 20%, rgba(0, 0, 0, 1) 40%, rgba(0, 0, 0, 0) 50%);
    }

    .progressive-blur.top > .layer:nth-child(3) {
        mask-image: linear-gradient(to top, rgba(0, 0, 0, 0) 15%, rgba(0, 0, 0, 1) 30%, rgba(0, 0, 0, 1) 50%, rgba(0, 0, 0, 0) 60%);
        -webkit-mask-image: linear-gradient(to top, rgba(0, 0, 0, 0) 15%, rgba(0, 0, 0, 1) 30%, rgba(0, 0, 0, 1) 50%, rgba(0, 0, 0, 0) 60%);
    }

    .progressive-blur.top > .layer:nth-child(4) {
        mask-image: linear-gradient(to top, rgba(0, 0, 0, 0) 20%, rgba(0, 0, 0, 1) 40%, rgba(0, 0, 0, 1) 60%, rgba(0, 0, 0, 0) 70%);
        -webkit-mask-image: linear-gradient(to top, rgba(0, 0, 0, 0) 20%, rgba(0, 0, 0, 1) 40%, rgba(0, 0, 0, 1) 60%, rgba(0, 0, 0, 0) 70%);
    }

    .progressive-blur.top > .layer:nth-child(5) {
        mask-image: linear-gradient(to top, rgba(0, 0, 0, 0) 40%, rgba(0, 0, 0, 1) 60%, rgba(0, 0, 0, 1) 80%, rgba(0, 0, 0, 0) 90%);
        -webkit-mask-image: linear-gradient(to top, rgba(0, 0, 0, 0) 40%, rgba(0, 0, 0, 1) 60%, rgba(0, 0, 0, 1) 80%, rgba(0, 0, 0, 0) 90%);
    }

    .progressive-blur.top > .layer:nth-child(6) {
        mask-image: linear-gradient(to top, rgba(0, 0, 0, 0) 60%, rgba(0, 0, 0, 1) 80%);
        -webkit-mask-image: linear-gradient(to top, rgba(0, 0, 0, 0) 60%, rgba(0, 0, 0, 1) 80%);
    }

    .progressive-blur.top > .layer:nth-child(7) {
        mask-image: linear-gradient(to top, rgba(0, 0, 0, 0) 70%, rgba(0, 0, 0, 1) 100%);
        -webkit-mask-image: linear-gradient(to top, rgba(0, 0, 0, 0) 70%, rgba(0, 0, 0, 1) 100%);
    }

    .progressive-blur.top > .gradient {
        background: linear-gradient(var(--surface), transparent);
    }
</style>
