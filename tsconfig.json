{
    "$schema": "./node_modules/@effect/tsgo/schema.json",
    "extends": "astro/tsconfigs/strict",
    "include": [".astro/types.d.ts", "**/*"],
    "exclude": ["dist"],
    "compilerOptions": {
        "paths": {
            "@/*": ["./src/*"]
        },
        "jsx": "preserve",
        "plugins": [
            {
                "name": "@effect/language-service",
                "diagnostics": false
            }
        ]
    }
}
